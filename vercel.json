{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/status?type=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/status?type=robots"
    },
    {
      "source": "/api/channel/:id",
      "destination": "/api/channel?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
