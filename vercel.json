{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__endpoint=status&type=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__endpoint=status&type=robots"
    },
    {
      "source": "/api/channel/:id",
      "destination": "/api/index?__endpoint=channel&id=:id"
    },
    {
      "source": "/api/brands/:key",
      "destination": "/api/index?__endpoint=brands&key=:key"
    },
    {
      "source": "/api/:endpoint",
      "destination": "/api/index?__endpoint=:endpoint"
    },
    {
      "source": "/channels",
      "destination": "/api/index?__endpoint=status&type=seo&route=channels"
    },
    {
      "source": "/channel/:id*",
      "destination": "/api/index?__endpoint=status&type=seo&route=channel&id=:id*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
